/* ==========================================================================
   Sorta — Modern Windows 11 / Material Desktop Theme
   Consistent, Spacious, Clean, Self-Explanatory
   ========================================================================== */

* {
    font-family: "Segoe UI", "Segoe UI Variable", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #0f172a;
    outline: none;
}

/* --- Window & Containers --- */
QMainWindow, QDialog {
    background-color: #f8fafc;
}

QWidget#centralWidget, QWidget#containerWidget {
    background-color: #f8fafc;
}

QScrollArea {
    background-color: #f8fafc;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #f8fafc;
}

QSplitter {
    background-color: #f8fafc;
}

QSplitter::handle {
    background-color: #e2e8f0;
    width: 3px;
    height: 3px;
}

QSplitter::handle:hover {
    background-color: #3b82f6;
}

/* --- Card Containers --- */
QFrame.cardFrame, QWidget.cardFrame {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin-top: 14px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
    font-size: 13px;
    color: #1e293b;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 1px 8px;
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 4px;
    color: #2563eb;
    font-weight: 600;
    font-size: 12px;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background-color: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background-color: #f1f5f9;
    color: #475569;
    padding: 10px 22px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
    font-size: 13px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2563eb;
    border: 1px solid #e2e8f0;
    border-bottom: 2px solid #2563eb;
}

QTabBar::tab:hover:!selected {
    background-color: #e2e8f0;
    color: #0f172a;
}

/* --- Inputs & Spinners --- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 10px;
    color: #0f172a;
    font-size: 13px;
    min-height: 20px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1.5px solid #2563eb;
    background-color: #ffffff;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

QLineEdit::placeholder {
    color: #94a3b8;
    font-style: italic;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #e2e8f0;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    selection-background-color: #eff6ff;
    selection-color: #2563eb;
    padding: 4px;
}

/* --- Buttons --- */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    font-size: 13px;
    color: #334155;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #f8fafc;
    border-color: #94a3b8;
    color: #0f172a;
}

QPushButton:pressed {
    background-color: #f1f5f9;
}

QPushButton:disabled {
    background-color: #f8fafc;
    color: #cbd5e1;
    border-color: #e2e8f0;
}

/* Primary Action Button (Blue) */
QPushButton#primaryButton {
    background-color: #2563eb;
    border: 1px solid #1d4ed8;
    color: #ffffff;
    font-weight: 600;
    font-size: 13.5px;
    padding: 9px 22px;
}

QPushButton#primaryButton:hover {
    background-color: #1d4ed8;
}

QPushButton#primaryButton:pressed {
    background-color: #1e40af;
}

QPushButton#primaryButton:disabled {
    background-color: #93c5fd;
    border-color: #93c5fd;
    color: #ffffff;
}

/* Secondary Action Button (Green) */
QPushButton#accentButton {
    background-color: #059669;
    border: 1px solid #047857;
    color: #ffffff;
    font-weight: 600;
    padding: 8px 18px;
}

QPushButton#accentButton:hover {
    background-color: #047857;
}

/* Danger Button (Red) */
QPushButton#dangerButton {
    background-color: #ef4444;
    border: 1px solid #dc2626;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    background-color: #dc2626;
}

/* Chip/Token Insertion Buttons */
QPushButton#tokenButton {
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 5px;
    color: #1d4ed8;
    font-weight: 600;
    font-size: 12px;
    padding: 5px 10px;
}

QPushButton#tokenButton:hover {
    background-color: #dbeafe;
    border-color: #93c5fd;
}

/* --- CheckBoxes & RadioButtons --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #1e293b;
    font-weight: 500;
    font-size: 13px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background-color: #ffffff;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #2563eb;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
}

/* --- Table View --- */
QTableView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #f1f5f9;
    selection-background-color: #eff6ff;
    selection-color: #0f172a;
    font-size: 12.5px;
    alternate-background-color: #f8fafc;
}

QTableView::item {
    padding: 6px 10px;
    border: none;
}

QTableView::item:selected {
    background-color: #e0e7ff;
    color: #1e1b4b;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #475569;
    padding: 9px 12px;
    border: none;
    border-right: 1px solid #e2e8f0;
    border-bottom: 1.5px solid #cbd5e1;
    font-weight: 600;
    font-size: 12px;
}

QHeaderView::section:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}

/* --- Progress Bar --- */
QProgressBar {
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    text-align: center;
    background-color: #e2e8f0;
    font-weight: 600;
    font-size: 11px;
    color: #1e293b;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 5px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
    color: #64748b;
    font-size: 12px;
    padding: 6px 12px;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background: #f1f5f9;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 25px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar:horizontal {
    border: none;
    background: #f1f5f9;
    height: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 25px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

/* --- Badges and Metric Pills --- */
QLabel#statusPillTotal {
    background-color: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
    border-radius: 12px;
    padding: 4px 12px;
    font-weight: 600;
    font-size: 12px;
}

QLabel#statusPillPending {
    background-color: #f0fdf4;
    color: #15803d;
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    padding: 4px 12px;
    font-weight: 600;
    font-size: 12px;
}

QLabel#statusPillConflict {
    background-color: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
    border-radius: 12px;
    padding: 4px 12px;
    font-weight: 600;
    font-size: 12px;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #0f172a;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}
